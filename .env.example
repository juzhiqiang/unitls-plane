# Database
DATABASE_URL=postgresql://utils:utils@localhost:5433/utils_plane

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3 兼容)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true     # MinIO 必需
# AI 生图提示词模板示例图所在的匿名只读桶，由 seed-image-generate-presets 脚本建桶并上传。
S3_PRESETS_BUCKET=presets
# 示例图源目录。不设时脚本按 /app/public/presets → apps/web/public/presets 顺序探测；
# 组合镜像里显式设为 /app/public/presets。
IMAGE_GENERATE_PRESETS_DIR=

# Better-Auth
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>
BETTER_AUTH_URL=http://localhost:3001
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_CALLBACK_URL=http://localhost:3000/zh/login?verified=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth (可选)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_RELEASE=dev

# Backend
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
ADMIN_USER=admin
ADMIN_PASSWORD=admin
RELEASE=dev
BUILD_COMMIT=dev
BUILD_TIME=

# ID photo AI cutout (optional, OpenAI-compatible)
# chat_mask: /v1/chat/completions returns {"mask":"data:image/png;base64,..."}
# image_result: /v1/images/edits uses the uploaded image as a reference
ID_PHOTO_AI_SEGMENTATION_BASE_URL=
ID_PHOTO_AI_SEGMENTATION_API_KEY=
ID_PHOTO_AI_SEGMENTATION_MODEL=gpt-4o-mini
ID_PHOTO_AI_SEGMENTATION_PROVIDER=chat_mask
ID_PHOTO_AI_IMAGE_SIZE=1024x1024
ID_PHOTO_AI_IMAGE_QUALITY=high
ID_PHOTO_AI_IMAGE_BACKGROUND=opaque
ID_PHOTO_AI_RESPONSE_FORMAT=url

# AI image generation (optional, OpenAI-compatible, text-to-image + image-to-image)
# 尺寸与质量是 per-request 的用户选择,由前端表单传入、zod schema 提供默认,不走 env
#
# 多来源:AI_IMAGE_PROVIDERS 是一个 JSON 数组,数组第一项是默认来源。配置它就等于
# 忽略下面那组 AI_IMAGE_* 单来源变量。新增一个兼容 OpenAI 格式的来源只需往数组里加一项,
# 不需要改代码。JSON 非法或字段不合法时 API 会启动失败(而不是静默关闭生图)。
#
# 每项字段:
#   id               必填,来源标识,只允许字母数字与 - _,创建任务时前端回传这个值
#   label            必填,展示给用户的名字。会下发到前端,不要写进主机名或密钥
#   baseUrl          必填,网关根地址,例如 https://api.openai.com
#   apiKey           可选,Authorization: Bearer 的值;少数自托管网关不校验
#   model            默认 gpt-image-1
#   capabilities     默认 ["generate","edit"];只支持文生图的来源写 ["generate"]
#   editTransport    默认 multipart(POST /v1/images/edits);
#                    generations_ref 表示图生图也打 /v1/images/generations,
#                    参考图放进 JSON 数组(kmage / image.dddd.zone 这类网关)
#   refImagesField   editTransport=generations_ref 时参考图字段名,默认 reference_images
#   refImageEncoding data_url(默认,data:image/png;base64,...)或 base64(裸 base64)
#   responseFormat   b64_json(默认)或 url;url 时产物会被下载后再存入 MinIO
#
# 单次上游请求超时(毫秒)。挂死上游(连上 TLS 却永不回响应)超过这个值即按失败处理,
# 避免无限期占用 worker。默认 180000,封顶 600000(须小于 BullMQ 的 lockDuration)
# AI_IMAGE_REQUEST_TIMEOUT_MS=180000
#
# AI_IMAGE_PROVIDERS='[{"id":"openai","label":"OpenAI","baseUrl":"https://api.openai.com","apiKey":"sk-xxx","model":"gpt-image-1"},{"id":"kmage","label":"KMage","baseUrl":"https://image.dddd.zone","apiKey":"kmage_xxx","model":"gpt-image-2","editTransport":"generations_ref","refImagesField":"reference_images","refImageEncoding":"data_url","responseFormat":"b64_json"}]'
AI_IMAGE_PROVIDERS=

# 单来源回退:只在 AI_IMAGE_PROVIDERS 为空时生效,等价于一个 id=default 的 multipart 来源
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_RESPONSE_FORMAT=b64_json
AI_IMAGE_LABEL=
