# ==========================================
# 1. 依赖与系统文件
# ==========================================
node_modules/
.pnpm-store/      # 如果使用 pnpm
.DS_Store
*.log

# ==========================================
# 2. Monorepo / 工具链自身的缓存
# ==========================================
.turbo/
dist/
build/

# 防止 tsc 输出物混进源码目录
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# ==========================================
# 3. Next.js 核心忽略项（关键：匹配所有子包）
# ==========================================
# 匹配根目录或任意 apps/*, packages/* 下的 .next 目录
.next/
**/.next/

# 忽略 Next.js 自动生成的类型文件
.pnp
.pnp.js

# ==========================================
# 4. 敏感信息与本地环境配置（绝对不能传！）
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# ==========================================
# 5. 其他常见框架产物（未雨绸缪）
# ==========================================
.output/
out/