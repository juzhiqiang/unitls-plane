# Database
DATABASE_URL=postgresql://utils:utils@localhost:5433/utils_plane

# Redis
REDIS_URL=redis://localhost:6379
# 账号摘要跨 API 实例共享缓存；设为 false 时仅使用进程内缓存。
ACCOUNT_SUMMARY_REDIS=true

# MinIO (S3 兼容)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true     # MinIO 必需
# AI 生图提示词模板示例图所在的匿名只读桶，由 seed-image-generate-presets 脚本建桶并上传。
S3_PRESETS_BUCKET=presets
# 示例图源目录。不设时脚本按 /app/public/presets → apps/web/public/presets 顺序探测；
# 组合镜像里显式设为 /app/public/presets。
IMAGE_GENERATE_PRESETS_DIR=

# Better-Auth
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>
BETTER_AUTH_URL=http://localhost:3001
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_CALLBACK_URL=http://localhost:3000/zh/login?verified=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth (可选)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_RELEASE=dev

# Backend
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
ADMIN_USER=admin
ADMIN_PASSWORD=admin
RELEASE=dev
BUILD_COMMIT=dev
BUILD_TIME=

# ID photo AI cutout (optional, OpenAI-compatible)
# chat_mask: /v1/chat/completions returns {"mask":"data:image/png;base64,..."}
# image_result: /v1/images/edits uses the uploaded image as a reference
ID_PHOTO_AI_SEGMENTATION_BASE_URL=
ID_PHOTO_AI_SEGMENTATION_API_KEY=
ID_PHOTO_AI_SEGMENTATION_MODEL=gpt-4o-mini
ID_PHOTO_AI_SEGMENTATION_PROVIDER=chat_mask
ID_PHOTO_AI_IMAGE_SIZE=1024x1024
ID_PHOTO_AI_IMAGE_QUALITY=high
ID_PHOTO_AI_IMAGE_BACKGROUND=opaque
ID_PHOTO_AI_RESPONSE_FORMAT=url

# AI image generation (optional, OpenAI-compatible, text-to-image + image-to-image)
# 尺寸与质量是 per-request 的用户选择,由前端表单传入、zod schema 提供默认,不走 env
#
# 多来源:AI_IMAGE_PROVIDERS 是一个 JSON 数组,数组第一项是默认来源。配置它就等于
# 忽略下面那组 AI_IMAGE_* 单来源变量。新增一个兼容 OpenAI 格式的来源只需往数组里加一项,
# 不需要改代码。JSON 非法或字段不合法时 API 会启动失败(而不是静默关闭生图)。
#
# 每项字段:
#   id               必填,来源标识,只允许字母数字与 - _(服务端路由用,不下发前端)
#   label            必填,内部诊断名(日志),不再展示给用户
#   baseUrl          必填,网关根地址,例如 https://api.openai.com
#   apiKey           可选,Authorization: Bearer 的值;少数自托管网关不校验
#   models           必填,模型数组(至少一项);每项:
#                      name         模型名,上游 API 的 model 参数原文,可含空格与大小写
#                      capabilities 默认 ["generate","edit"];只支持文生图写 ["generate"],
#                                   支持 inpaint 的显式加 "inpaint"。同一模型可以配在多个
#                                   来源下:生成时服务端在它们之间随机挑一个,可重试失败
#                                   (超时/5xx/限流)自动换下一个来源;同会话同模型沿用
#                                   上次实际使用的来源
#                      sizes        默认七档 1024x1024/1024x1536/1536x1024/864x1152/
#                                   1152x864/864x1536/1536x864;要 "自动" 档显式加 "auto"
#   editTransport    默认 multipart(POST /v1/images/edits);
#                    generations_ref 表示图生图也打 /v1/images/generations,
#                    参考图放进 JSON 数组(kmage / image.dddd.zone 这类网关)
#   refImagesField   editTransport=generations_ref 时参考图字段名,默认 reference_images
#   refImageEncoding data_url(默认,data:image/png;base64,...)或 base64(裸 base64)
#   responseFormat   b64_json(默认)或 url;url 时产物会被下载后再存入 MinIO
#   omitBodyFields   默认 [];从请求体里删掉列出的可选字段,可选值 size / quality /
#                    response_format / n。给严格校验请求体的网关用:多一个不认识的字段
#                    就整个 400(wan 回「请求包含未知字段」),gpt-image-1 也不再收
#                    response_format。例:"omitBodyFields":["quality","response_format"]
#
# 单次上游请求超时(毫秒)。挂死上游(连上 TLS 却永不回响应)超过这个值即按失败处理,
# 避免无限期占用 worker。默认 180000,封顶 600000(须小于 BullMQ 的 lockDuration)。
# 注意:同一模型配多个来源时,换源重试是串行的,最坏耗时 = 来源数 × 超时,别配太多
# AI_IMAGE_REQUEST_TIMEOUT_MS=180000
#
# AI_IMAGE_PROVIDERS='[{"id":"openai","label":"OpenAI","baseUrl":"https://api.openai.com","apiKey":"sk-xxx","models":[{"name":"gpt-image-1","capabilities":["generate","edit","inpaint"],"sizes":["auto","1024x1024","1024x1536","1536x1024"]}]},{"id":"kmage","label":"KMage","baseUrl":"https://image.dddd.zone","apiKey":"kmage_xxx","models":[{"name":"KMage V2"},{"name":"gpt-image-2","capabilities":["generate","edit","inpaint"],"sizes":["auto","1024x1024"]}],"editTransport":"generations_ref","refImagesField":"reference_images","refImageEncoding":"data_url","responseFormat":"b64_json"}]'
AI_IMAGE_PROVIDERS=

# 单来源回退:只在 AI_IMAGE_PROVIDERS 为空时生效,等价于一个 id=default、
# 单模型(AI_IMAGE_MODEL)的 multipart 来源
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_RESPONSE_FORMAT=b64_json
AI_IMAGE_LABEL=

# 上传临时文件目录；留空时使用系统临时目录下的 utils-plane-uploads。
# 目录由 API 启动时创建并限制为当前进程可读写，生产环境建议使用独立本地盘。
UPLOAD_TEMP_DIR=
# 进程级上传并发上限（1-32），在 Multer 写入临时文件前拒绝超限请求，返回 503。
UPLOAD_MAX_CONCURRENT=2
# 可选上传完成/失败内存日志，不记录文件名或正文。
PERFORMANCE_MEMORY_LOG=false
# 各 API 进程的任务处理并发（1-32），应结合容器内存与队列输入规模设置。
IMAGE_WORKER_CONCURRENCY=2
PDF_WORKER_CONCURRENCY=2
FONT_WORKER_CONCURRENCY=2
AI_WORKER_CONCURRENCY=8
