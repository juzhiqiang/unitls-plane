  "info": {
    "title": "Utils-Plane API",
    "description": "工具平台 API 文档",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "compress",
              "convert",
              "image_watermark",
              "image_id_photo",
              "pdf_merge",
              "pdf_split",
              "pdf_to_image",
              "font_convert",
              "pdf_to_text",
              "image_to_pdf",
              "pdf_rotate",
              "pdf_watermark",
              "pdf_encrypt",
              "pdf_compress",
              "pdf_metadata",
              "pdf_rearrange",
              "pdf_from_document",
              "image_generate"
            ]
          },
          "inputFileIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "inputConfig": {
            "type": "object"
          }
        },
        "required": [
          "type",
          "inputFileIds"
        ]
      },
      "TaskResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "compress",
              "convert",
              "image_watermark",
              "image_id_photo",
              "pdf_merge",
              "pdf_split",
              "pdf_to_image",
              "font_convert",
              "pdf_to_text",
              "image_to_pdf",
              "pdf_rotate",
              "pdf_watermark",
              "pdf_encrypt",
              "pdf_compress",
              "pdf_metadata",
              "pdf_rearrange",
              "pdf_from_document",
              "image_generate"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ]
          },
          "inputFileIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputConfig": {
            "type": "object"
          },
          "outputFileId": {
            "type": "string",
            "format": "uuid"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "errorCode": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "completedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "inputFileIds",
          "progress",
          "createdAt"
        ]
      },
      "ImageGenerateQuotaDto": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "当日生图张数上限"
          },
          "used": {
            "type": "number",
            "description": "今日已用张数（失败的生成不计数）"
          },
          "remaining": {
            "type": "number",
            "description": "今日剩余张数"
          }
        },
        "required": [
          "limit",
          "used",
          "remaining"
        ]
      },
      "TaskStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "outputFileId": {
            "type": "string",
            "format": "uuid"
          },
          "errorCode": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "progress"
        ]
      },
      "FileIdsDto": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "ids"
        ]
      },
      "LiveHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "release": {
            "type": "string",
            "example": "dev"
          },
          "buildCommit": {
            "type": "string",
            "example": "dev"
          },
          "buildTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "status",
          "timestamp",
          "startedAt",
          "release",
          "buildCommit",
          "buildTime"
        ]
      },
      "HealthComponentDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "error"
            ]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "durationMs"
        ]
      },
      "HealthComponentsDto": {
