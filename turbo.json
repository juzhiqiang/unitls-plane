{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "@utils-plane/api-client#generate": {
      "dependsOn": ["@utils-plane/api#openapi:export"],
      "cache": false
    },
    "@utils-plane/api-client#build": {
      "dependsOn": ["generate"]
    }
  }
}
