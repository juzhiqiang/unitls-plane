            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ]
          },
          "inputFileIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputConfig": {
            "type": "object"
          },
          "outputFileId": {
            "type": "string",
            "format": "uuid"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "errorCode": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "completedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "inputFileIds",
          "progress",
          "createdAt"
        ]
      },
