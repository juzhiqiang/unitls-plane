# ==========================================
# 1. 依赖与系统文件
# ==========================================
node_modules/
.pnpm-store/      # 如果使用 pnpm
.DS_Store
*.log
*.err
log/
artifacts/screenshots/
.playwright-mcp/

# ==========================================
# 2. Monorepo / 工具链自身的缓存
# ==========================================
.turbo/
.worktrees/
.superpowers/
dist/
build/

# 防止 tsc 输出物混进源码目录
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Hand-written source declarations.
!apps/api/src/types/**/*.d.ts

# ==========================================
# 3. Next.js 核心忽略项（关键：匹配所有子包）
# ==========================================
# 匹配根目录或任意 apps/*, packages/* 下的 .next 目录
.next/
**/.next/

# 忽略 Next.js 自动生成的类型文件
.pnp
.pnp.js

# ==========================================
# 4. 敏感信息与本地环境配置（绝对不能传！）
# ==========================================
.env
.env.local
.env.prod
.env.development.local
.env.test.local
.env.production.local
*.env.local

# ==========================================
# 5. 其他常见框架产物（未雨绸缪）
# ==========================================
.output/
out/

# PWA files generated by next-pwa during production builds.
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/workbox-*.js
apps/web/public/workbox-*.js.map
apps/web/public/fallback-*.js
apps/web/public/fallback-*.js.map
apps/web/public/swe-worker-*.js
apps/web/public/swe-worker-*.js.map

# Docker image exports for manual server deployment.
utils-plane-all.tar
utils-plane-api.tar
utils-plane-offline-all.tar

# Local ML model assets.
apps/api/models/*.onnx
